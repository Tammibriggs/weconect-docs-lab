{
  "name": "keys_list_expired_token",
  "group": "List API keys",
  "request": {
    "method": "GET",
    "path": "/api/keys",
    "headers": {
      "Authorization": "Bearer <redacted JWT>"
    }
  },
  "response": {
    "status": 403,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "status": "error",
      "expired": true,
      "message": "Your session has expired"
    }
  },
  "durationMs": 5
}
