{
  "name": "profile_update",
  "group": "Update the current user",
  "request": {
    "method": "PUT",
    "path": "/api/users",
    "headers": {
      "Authorization": "Bearer <redacted JWT>",
      "Content-Type": "application/json"
    },
    "body": {
      "username": "erin",
      "bio": "Coffee and code",
      "profilePicture": {
        "url": "https://example.com/erin.jpg",
        "filename": "erin.jpg"
      },
      "coverPicture": {
        "url": "https://example.com/erin-cover.jpg",
        "filename": "erin-cover.jpg"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "status": "ok"
    }
  },
  "durationMs": 13
}
