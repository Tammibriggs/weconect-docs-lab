{
  "name": "register_password_mismatch",
  "group": "Register",
  "request": {
    "method": "POST",
    "path": "/api/auth/register",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "username": "dave",
      "password": "<redacted encrypted password>",
      "password1": "secret9"
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "status": "error",
      "message": "Password does not match"
    }
  },
  "durationMs": 8
}
